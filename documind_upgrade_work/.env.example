# Gemini API key. Keep the real key in .env (never commit it).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model IDs can be overridden without changing application code.
GEMINI_GENERATION_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"
GEMINI_THINKING_LEVEL="medium"

# Local app port. Defaults to 3000.
PORT="3000"

# Public app URL, when deployed. Optional for local development.
APP_URL="http://localhost:3000"
